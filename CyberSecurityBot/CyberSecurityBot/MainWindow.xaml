        <!-- Chat display -->
        <ListBox x:Name="ChatList"
         Grid.Row="1"
         Background="#161A25"
		 Height="400"
         VerticalAlignment="Bottom"
         Foreground="White"
         BorderThickness="2"
         FontSize="14"/>

        <!-- Input area container -->
        <Border Grid.Row="2"
        Background="#1E2433"
        Height="45"
        VerticalAlignment="Bottom"
        CornerRadius="10"
        Padding="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <!-- Input box -->
                <TextBox x:Name="UserInputTextBox"
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         FontSize="14"
                         VerticalAlignment="Center"
                         Padding="5"
                         CaretBrush="White"
						 Text ="Type here"/>

                <!-- Send button -->
                <Button Content="Send"
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Background="#4C7DFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="SendButton_Click"/>
               
            </Grid>
        </Border>

    </Grid>
</Window>
