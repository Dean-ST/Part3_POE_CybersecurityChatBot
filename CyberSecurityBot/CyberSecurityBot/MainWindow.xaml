<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Chatbot"
        Height="700"
        Width="1100"
        MinHeight="650"
        MinWidth="1000"
        Background="#0F111A"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ASCII ART -->
        <TextBlock
            Grid.Row="0"
            Foreground="SkyBlue"
            FontFamily="Courier New"
            FontSize="9"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,10,0,20"
            Text="
 ███  █   █ ████  █████ ████   ████ █████  ███  █   █ ████  ███ █████ █   █    ████   ███  █████
█ ░░░  █ █ ░█░░░█ █░░░░░█░░░█ █ ░░░░█░░░░░█ ░░░ █░  █░█░░░█  █░░ ░█░░░ █ █ ░   █░░░█ █ ░░█  ░█░░░
█░ ░░░  █ ░ ████░░████░░████░░ ███░░████░░█░ ░░░█░░ █░████░░ █░░░ █░░░░ █ ░ ░  ████░░█░ ░█░  █░░░░
█░░     █░ ░█░░░█ █░░░░ █░░█░ ░ ░░█ █░░░░ █░░   █░░ █░█░░█░ ░█░░  █░░   █░ ░   █░░░█ █░░ █░░ █░░
 ███    █░░ ████░░█████░█░░░█░████░░█████░ ███   ███ ░█░░░█░███░  █░░   █░░    ████░░ ███ ░░ █░░
  ░░░    ░░  ░░░░ ░░░░░░ ░░  ░ ░░░░ ░░░░░░  ░░░   ░░░ ░░░  ░ ░░░   ░░    ░░     ░░░░ ░ ░░░ ░  ░░
   ░░░    ░   ░░░░  ░░░░░ ░   ░ ░░░░  ░░░░░  ░░░   ░░░  ░   ░ ░░░   ░     ░      ░░░░   ░░░    ░
"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    Background="#161A25"
                    Foreground="White">

            <!-- CHAT TAB -->
            <TabItem Header="💬 Chat">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ChatList"
                             Grid.Row="0"
                             Background="#161A25"
                             Foreground="White"
                             BorderThickness="2"
                             FontSize="14"/>

                    <Border Grid.Row="1"
                            Background="#1E2433"
                            Height="45"
                            CornerRadius="10"
                            Padding="8"
                            Margin="0,10,0,0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UserInputTextBox"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Padding="5"
                                     CaretBrush="White"/>

                            <Button Content="Send"
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Background="#4C7DFF"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Border>

                </Grid>

            </TabItem>

            <!-- TASK TAB -->
            <TabItem Header="📋 Tasks">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TaskTitleTextBox"
                             Grid.Row="0"
                             Height="30"
                             Margin="0,5"
                             Text="Task Title"/>

                    <TextBox x:Name="TaskDescriptionTextBox"
                             Grid.Row="1"
                             Height="30"
                             Margin="0,5"
                             Text="Task Description"/>

                    <TextBox x:Name="ReminderTextBox"
                             Grid.Row="2"
                             Height="30"
                             Margin="0,5"
                             Text="Reminder"/>

                    <Button x:Name="AddTaskButton"
                            Grid.Row="3"
                            Content="Add Task"
                            Height="35"
                            Margin="0,10"
                            Background="#4C7DFF"
                            Foreground="White"/>

                    <ListBox x:Name="TasksListBox"
                             Grid.Row="4"
                             Background="#1E2433"
                             Foreground="White"/>

                </Grid>

            </TabItem>

            <!-- QUIZ TAB -->
            <TabItem Header="🧠 Quiz">

                <Grid Margin="20">

                    <StackPanel>

                        <TextBlock x:Name="QuestionTextBlock"
                                   FontSize="18"
                                   Foreground="White"
                                   Margin="0,10"/>

                        <StackPanel x:Name="AnswersPanel"
                                    Margin="0,20"/>

                        <Button x:Name="SubmitQuizButton"
                                Content="Submit Answer"
                                Height="35"
                                Width="200"
                                Background="#4C7DFF"
                                Foreground="White"/>

                        <TextBlock x:Name="QuizFeedbackText"
                                   Margin="0,20"
                                   FontSize="16"
                                   Foreground="LightGreen"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- ACTIVITY LOG TAB -->
            <TabItem Header="📜 Activity Log">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ActivityLogListBox"
                             Grid.Row="0"
                             Background="#1E2433"
                             Foreground="White"/>

                    <Button x:Name="ShowMoreButton"
                            Grid.Row="1"
                            Content="Show More"
                            Height="35"
                            Margin="0,10"
                            Background="#4C7DFF"
                            Foreground="White"/>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>
</Window>